# ==========================================
# Lyftr AI Full-Stack Assignment Environment Variables
# ==========================================

# Comma-separated API key pool (at least 2 keys).
# Key IDs are assigned in order: key_1, key_2, key_3...
# Supports real keys or mock keys for testing.
LLM_API_KEYS=mock-key-alpha-12345,mock-key-beta-67890

# Database URL for SQLite (in Docker this mounts to /data/app.db)
DATABASE_URL=sqlite:////data/app.db

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable failover test hook via X-Simulate-Failure header (true / false)
ENABLE_FAILURE_SIMULATION=true

# Default LiteLLM model
LLM_MODEL=gemini/gemini-2.0-flash

# Optional comma-separated model overrides matching LLM_API_KEYS 1:1
# Example: gemini/gemini-2.0-flash,groq/llama-3.3-70b-versatile
LLM_MODELS=

# Default System Prompt for new sessions
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise AI assistant.

# LiteLLM Cache Type: local (in-memory) or disk
LITELLM_CACHE_TYPE=local

# Per-attempt request timeout in seconds
LLM_TIMEOUT_SECONDS=25
